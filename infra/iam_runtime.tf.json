{
  "resource": {
    "aws_iam_role": {
      "silver": {
        "name": "${var.project}-silver-role",
        "assume_role_policy": "${data.aws_iam_policy_document.glue_assume.json}"
      },
      "gold": {
        "name": "${var.project}-gold-role",
        "assume_role_policy": "${data.aws_iam_policy_document.glue_assume.json}"
      },
      "crawler": {
        "name": "${var.project}-crawler-role",
        "assume_role_policy": "${data.aws_iam_policy_document.glue_assume.json}"
      },
      "dashboard_reader": {
        "count": "${length(var.dashboard_reader_principal_arns) > 0 ? 1 : 0}",
        "name": "${var.project}-dashboard-reader-role",
        "assume_role_policy": "${jsonencode({Version=\"2012-10-17\",Statement=[{Effect=\"Allow\",Principal={AWS=var.dashboard_reader_principal_arns},Action=\"sts:AssumeRole\"}]})}",
        "max_session_duration": 3600
      }
    },
    "aws_iam_role_policy": {
      "silver": {
        "name": "${var.project}-silver",
        "role": "${aws_iam_role.silver.id}",
        "policy": "${jsonencode({\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"ReadInputs\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/bronze/*\", \"${aws_s3_bucket.lake.arn}/control/ingestion/*\", \"${aws_s3_bucket.lake.arn}/silver/*\", \"${aws_s3_bucket.lake.arn}/state/silver/latest.json\"]}, {\"Sid\": \"ReadCode\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.scripts.arn}/jobs/bronze_to_silver.py\", \"${aws_s3_bucket.scripts.arn}/jobs/pipeline_contract.py\"]}, {\"Sid\": \"WriteOutputs\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\", \"s3:PutObject\", \"s3:DeleteObject\", \"s3:AbortMultipartUpload\", \"s3:ListMultipartUploadParts\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/silver/runs/*\", \"${aws_s3_bucket.lake.arn}/quality/silver_jobs/*\", \"${aws_s3_bucket.scripts.arn}/tmp/silver/*\"]}, {\"Sid\": \"BucketMetadata\", \"Effect\": \"Allow\", \"Action\": [\"s3:ListBucket\", \"s3:GetBucketLocation\", \"s3:ListBucketMultipartUploads\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\", \"${aws_s3_bucket.scripts.arn}\"]}, {\"Sid\": \"GlueLogs\", \"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogGroup\", \"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"arn:aws:logs:${var.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws-glue/*\"]}, {\"Sid\": \"GlueMetrics\", \"Effect\": \"Allow\", \"Action\": [\"cloudwatch:PutMetricData\"], \"Resource\": [\"*\"], \"Condition\": {\"StringEquals\": {\"cloudwatch:namespace\": [\"Glue\", \"Glue Data Quality\"]}}}, {\"Sid\": \"OwnJobStatus\", \"Effect\": \"Allow\", \"Action\": [\"glue:GetJob\", \"glue:GetJobRun\", \"glue:GetJobRuns\"], \"Resource\": [\"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:job/${var.project}-bronze-to-silver\"]}, {\"Sid\": \"PublishSilverState\", \"Effect\": \"Allow\", \"Action\": [\"s3:PutObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/state/silver/latest.json\"]}, {\"Sid\": \"PublishQuality\", \"Effect\": \"Allow\", \"Action\": [\"glue:PublishDataQuality\", \"glue:GetDataQualityResult\"], \"Resource\": [\"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:dataQualityRuleset/*\"]}]})}"
      },
      "gold": {
        "name": "${var.project}-gold",
        "role": "${aws_iam_role.gold.id}",
        "policy": "${jsonencode({\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"ReadInputs\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/silver/runs/*\", \"${aws_s3_bucket.lake.arn}/state/silver/latest.json\", \"${aws_s3_bucket.lake.arn}/control/ingestion/*\"]}, {\"Sid\": \"ReadCode\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.scripts.arn}/jobs/silver_to_gold.py\", \"${aws_s3_bucket.scripts.arn}/jobs/pipeline_contract.py\"]}, {\"Sid\": \"WriteOutputs\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\", \"s3:PutObject\", \"s3:DeleteObject\", \"s3:AbortMultipartUpload\", \"s3:ListMultipartUploadParts\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/gold/fact_job_posting/*\", \"${aws_s3_bucket.lake.arn}/gold/demand_by_role/*\", \"${aws_s3_bucket.lake.arn}/gold/role_opportunity/*\", \"${aws_s3_bucket.scripts.arn}/tmp/gold/*\"]}, {\"Sid\": \"BucketMetadata\", \"Effect\": \"Allow\", \"Action\": [\"s3:ListBucket\", \"s3:GetBucketLocation\", \"s3:ListBucketMultipartUploads\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\", \"${aws_s3_bucket.scripts.arn}\"]}, {\"Sid\": \"GlueLogs\", \"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogGroup\", \"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"arn:aws:logs:${var.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws-glue/*\"]}, {\"Sid\": \"GlueMetrics\", \"Effect\": \"Allow\", \"Action\": [\"cloudwatch:PutMetricData\"], \"Resource\": [\"*\"], \"Condition\": {\"StringEquals\": {\"cloudwatch:namespace\": [\"Glue\", \"Glue Data Quality\"]}}}, {\"Sid\": \"OwnJobStatus\", \"Effect\": \"Allow\", \"Action\": [\"glue:GetJob\", \"glue:GetJobRun\", \"glue:GetJobRuns\"], \"Resource\": [\"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:job/${var.project}-silver-to-gold\"]}, {\"Sid\": \"GoldDirectoryMarkers\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\", \"s3:PutObject\", \"s3:DeleteObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/gold/fact_job_posting_$folder$\", \"${aws_s3_bucket.lake.arn}/gold/demand_by_role_$folder$\", \"${aws_s3_bucket.lake.arn}/gold/role_opportunity_$folder$\"]}]})}"
      },
      "crawler": {
        "name": "${var.project}-crawler",
        "role": "${aws_iam_role.crawler.id}",
        "policy": "${jsonencode({\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"ReadGold\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/gold/*\"]}, {\"Sid\": \"ListGold\", \"Effect\": \"Allow\", \"Action\": [\"s3:ListBucket\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\"], \"Condition\": {\"StringLike\": {\"s3:prefix\": [\"gold\", \"gold/\", \"gold/*\"]}}}, {\"Sid\": \"BucketLocation\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetBucketLocation\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\"]}, {\"Sid\": \"GoldCatalog\", \"Effect\": \"Allow\", \"Action\": [\"glue:GetDatabase\", \"glue:GetTable\", \"glue:GetTables\", \"glue:GetPartition\", \"glue:GetPartitions\", \"glue:BatchGetPartition\", \"glue:CreateTable\", \"glue:UpdateTable\", \"glue:CreatePartition\", \"glue:BatchCreatePartition\", \"glue:UpdatePartition\", \"glue:BatchUpdatePartition\"], \"Resource\": [\"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:catalog\", \"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:database/${var.gold_database_name}\", \"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:table/${var.gold_database_name}/*\"]}, {\"Sid\": \"CrawlerLogs\", \"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogGroup\", \"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"arn:aws:logs:${var.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws-glue/*\"]}]})}"
      },
      "dashboard_reader": {
        "name": "${var.project}-dashboard-reader",
        "role": "${aws_iam_role.dashboard_reader[0].id}",
        "policy": "${jsonencode({\"Version\": \"2012-10-17\", \"Statement\": [{\"Sid\": \"ReadPublishedData\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}/gold/*\", \"${aws_s3_bucket.lake.arn}/state/pipeline/latest.json\", \"${aws_s3_bucket.lake.arn}/state/silver/latest.json\", \"${aws_s3_bucket.lake.arn}/control/ingestion/*/manifest.json\"]}, {\"Sid\": \"ListPublishedData\", \"Effect\": \"Allow\", \"Action\": [\"s3:ListBucket\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\"], \"Condition\": {\"StringLike\": {\"s3:prefix\": [\"gold\", \"gold/*\", \"state/*\", \"control/ingestion/*\"]}}}, {\"Sid\": \"BucketLocation\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetBucketLocation\"], \"Resource\": [\"${aws_s3_bucket.lake.arn}\", \"${aws_s3_bucket.athena_results.arn}\"]}, {\"Sid\": \"QueryResults\", \"Effect\": \"Allow\", \"Action\": [\"s3:GetObject\", \"s3:PutObject\", \"s3:AbortMultipartUpload\", \"s3:ListMultipartUploadParts\"], \"Resource\": [\"${aws_s3_bucket.athena_results.arn}/results/*\"]}, {\"Sid\": \"ListResults\", \"Effect\": \"Allow\", \"Action\": [\"s3:ListBucket\", \"s3:ListBucketMultipartUploads\"], \"Resource\": [\"${aws_s3_bucket.athena_results.arn}\"]}, {\"Sid\": \"AthenaQueries\", \"Effect\": \"Allow\", \"Action\": [\"athena:StartQueryExecution\", \"athena:GetQueryExecution\", \"athena:GetQueryResults\", \"athena:StopQueryExecution\", \"athena:GetWorkGroup\"], \"Resource\": [\"${aws_athena_workgroup.main.arn}\"]}, {\"Sid\": \"CatalogRead\", \"Effect\": \"Allow\", \"Action\": [\"glue:GetDatabase\", \"glue:GetTable\", \"glue:GetPartitions\", \"glue:GetPartition\", \"glue:BatchGetPartition\"], \"Resource\": [\"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:catalog\", \"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:database/${var.gold_database_name}\", \"arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:table/${var.gold_database_name}/*\"]}, {\"Sid\": \"ReadPipelineLock\", \"Effect\": \"Allow\", \"Action\": [\"dynamodb:GetItem\"], \"Resource\": [\"${aws_dynamodb_table.pipeline_lock.arn}\"], \"Condition\": {\"ForAllValues:StringEquals\": {\"dynamodb:LeadingKeys\": [\"pipeline\"]}}}]})}",
        "count": "${length(var.dashboard_reader_principal_arns) > 0 ? 1 : 0}"
      }
    }
  }
}
